#!/usr/bin/env bash

# Note: this script can be sourced or run

# Use environment variables to override a git config setting
set-git-config-env()
{
	local COUNT=${GIT_CONFIG_COUNT:-0}
	export "GIT_CONFIG_KEY_${COUNT}=${1%%=*}"
	export "GIT_CONFIG_VALUE_${COUNT}=${1#*=}"
	export "GIT_CONFIG_COUNT=$((COUNT + 1))"
}

set-git-config-env \
	diff.cbor.textconv="'$(dirname "$(realpath "${BASH_SOURCE[0]}")")/cbor-textconv.sh'"

# If this file is being run rather than sourced, run our arguments as a command
if [[ ${BASH_SOURCE[0]} == "$0" ]]; then exec "$@"; fi
