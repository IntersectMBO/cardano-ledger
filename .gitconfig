# The values in this file can be overridden on a per-clone basis in `.git/config`
# (eg using `git config set ...`).
[blame]
    ignoreRevsFile = .git-blame-ignore-revs
[fsck]
    skipList = .git-fsck-skiplist
[diff "cbor"]
    maxBytes = 128k
    # This is controlled using `scripts/with-cbor-diff` but can be overridden permanently
    # as described above
    # textconv = scripts/cbor-textconv.sh
